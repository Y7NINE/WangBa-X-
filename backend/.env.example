# WangBa-X 后端环境变量样例
# 复制为 .env 后按需修改

# 运行环境
NODE_ENV=development

# 服务端口
PORT=3000

# 数据库类型: sqlite | postgres
DB_TYPE=sqlite

# SQLite 路径（DB_TYPE=sqlite 时生效）
DB_DATABASE=netcafe.db

# PostgreSQL 连接（DB_TYPE=postgres 时生效）
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=netcafe
# DB_SYNCHRONIZE=true
# DB_SSL=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 固定验证码仅在本地演示模式生效，生产环境始终禁用
DEMO_MODE=false
HOST=127.0.0.1
